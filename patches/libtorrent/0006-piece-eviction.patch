+
+namespace libtorrent {
+
+	// For disk_interface implementations which drop pieces (a RAM cache). ``torrent`` is
+	// the object passed to disk_interface::new_torrent(). The torrent stops considering
+	// the piece as had: it tells its peers (lt_donthave) and downloads it again when
+	// it is wanted. Must be called on the network thread (post it on the io_context
+	// given to the disk_interface constructor).
+	TORRENT_EXPORT void torrent_lost_piece(std::shared_ptr<void> const& torrent
+		, piece_index_t piece);
+}
+
+#endif
