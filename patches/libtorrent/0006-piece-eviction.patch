 	// this is called when we were finished, but some files were
 	// marked for downloading, and we are no longer finished
+	void torrent::lost_piece(piece_index_t const piece)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (m_abort || !valid_metadata() || !m_connections_initialized) return;
+		if (piece < piece_index_t(0) || piece >= m_torrent_file->end_piece()) return;
+		if (!has_picker() && !m_have_all) return;
+
+		bool const was_finished = is_finished();
+		if (m_seed_mode) leave_seed_mode(seed_mode_t::skip_checking);
+		need_picker();
+		if (!m_picker->have_piece(piece)) return;
+
+#ifndef TORRENT_DISABLE_LOGGING
+		debug_log("*** LOST_PIECE (%d)", static_cast<int>(piece));
+#endif
+		m_picker->we_dont_have(piece);
+		m_have_all = false;
+
+		// the per-file progress only counts up: recount it
+		m_file_progress.clear();
+		m_file_progress.init(*m_picker, m_torrent_file->files());
+
+		for (auto* p : m_connections)
+		{
+			TORRENT_INCREMENT(m_iterating_connections);
+			p->write_dont_have(piece);
+		}
+
+		update_gauge();
+		set_need_save_resume(torrent_handle::if_download_progress);
+		update_peer_interest(was_finished);
+	}
+
+	void torrent_lost_piece(std::shared_ptr<void> const& t, piece_index_t const piece)
+	{
+		if (!t) return;
+		static_cast<torrent*>(t.get())->lost_piece(piece);
+	}
