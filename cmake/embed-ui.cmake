# The web interface (plugins/mediamesh, the Silo plugin's pages) as C++ arrays: cmake -DUI_DIR=... -DOUT=... -P embed-ui.cmake
set(FILES index.html app.js style.css)
# (no ";" in an item: CMake splits lists on it; the charset is added below)
set(TYPES text/html text/javascript text/css)
set(SRC "// made by cmake/embed-ui.cmake from plugins/mediamesh\n#include \"ui_files.hpp\"\n\nnamespace p2p {\n")
set(TABLE "")
set(I 0)
foreach (F ${FILES})
    list(GET TYPES ${I} TYPE)
    file(READ ${UI_DIR}/${F} HEXDATA HEX)
    string(LENGTH "${HEXDATA}" N)
    math(EXPR SIZE "${N} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEXDATA}")
    string(APPEND SRC "    static const unsigned char kUi${I}[] = {${BYTES}0};\n")
    string(APPEND TABLE "            {\"/${F}\", \"${TYPE}; charset=utf-8\", kUi${I}, ${SIZE}},\n")
    math(EXPR I "${I} + 1")
endforeach ()
string(APPEND SRC "\n    const UiFile *uiFile(const std::string &path) {\n        static const UiFile files[] = {\n${TABLE}        };\n")
string(APPEND SRC "        for (const UiFile &f : files) {\n            if (path == f.path) {\n                return &f;\n            }\n        }\n        return nullptr;\n    }\n\n}\n")
file(WRITE ${OUT}.tmp "${SRC}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
