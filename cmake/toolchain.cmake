# Toolchain selection before project(), the same SDKs as pPlay

if (PLATFORM_SWITCH)
    if (NOT DEFINED ENV{DEVKITPRO})
        message(FATAL_ERROR "DEVKITPRO is not set")
    endif ()
    set(DEVKITPRO $ENV{DEVKITPRO} CACHE STRING "DEVKITPRO" FORCE)
    set(TARGET_PLATFORM switch CACHE STRING "" FORCE)
    if (NOT DEFINED CMAKE_TOOLCHAIN_FILE)
        set(CMAKE_TOOLCHAIN_FILE "${DEVKITPRO}/cmake/Switch.cmake" CACHE PATH "toolchain file")
    endif ()
    set(P2P_PLATFORM_DEFINES __SWITCH__)
elseif (PLATFORM_PS4)
    if (NOT DEFINED ENV{OPENORBIS})
        message(FATAL_ERROR "OPENORBIS is not set")
    endif ()
    set(OPENORBIS $ENV{OPENORBIS} CACHE STRING "OPENORBIS" FORCE)
    set(TARGET_PLATFORM ps4 CACHE STRING "" FORCE)
    if (NOT DEFINED CMAKE_TOOLCHAIN_FILE)
        set(CMAKE_TOOLCHAIN_FILE "${OPENORBIS}/cmake/ps4.cmake" CACHE PATH "toolchain file")
    endif ()
    set(P2P_PLATFORM_DEFINES __PS4__)
elseif (PLATFORM_PS5)
    # configured through prospero-cmake (ps5-payload-sdk)
    set(TARGET_PLATFORM ps5 CACHE STRING "" FORCE)
    set(P2P_PLATFORM_DEFINES __PS5__)
elseif (PLATFORM_ANDROID)
    # NDK: a command-line executable for adb shell (arm64-v8a or armeabi-v7a, Android 6+ as pPlay)
    if (NOT DEFINED CMAKE_TOOLCHAIN_FILE)
        if (NOT DEFINED ENV{ANDROID_NDK_HOME})
            message(FATAL_ERROR "ANDROID_NDK_HOME is not set")
        endif ()
        set(CMAKE_TOOLCHAIN_FILE "$ENV{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake" CACHE PATH "toolchain file")
    endif ()
    if (NOT DEFINED ANDROID_ABI)
        set(ANDROID_ABI arm64-v8a CACHE STRING "")
    endif ()
    set(ANDROID_PLATFORM android-23 CACHE STRING "")
    set(ANDROID_STL c++_static CACHE STRING "")
    set(TARGET_PLATFORM android CACHE STRING "" FORCE)
else ()
    set(PLATFORM_LINUX ON CACHE BOOL "" FORCE)
    set(TARGET_PLATFORM linux CACHE STRING "" FORCE)
endif ()

message(STATUS "P2Play: target platform ${TARGET_PLATFORM}")
