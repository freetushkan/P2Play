  },
  "sources": [
    {
      "id": "torrents-csv-data",
      "type": "csv",
      "enabled": false,
      "priority": 10,
      "repo": "../sources/torrents-csv-data",
      "data_file": "torrents.csv",
      "date_field": "created_unix",
      "inventory_categories": {
        "Video": [
          "(?i)\\.(?:mkv|mp4|m4v|avi|mov|wmv|flv|webm|mpg|mpeg|m2ts|ts|vob)(?:$|[\\s)\\]])",
          "(?i)\\b(?:DVDRip|DVD-Rip|BDRip|BRRip|BluRay|Blu-Ray|WEBRip|WEB-DL|WEB-DLRip|HDTV|HDRip|REMUX|AVC|HEVC|H\\.264|H\\.265|x264|x265|XviD)\\b"
        ],
        "Music": [
          "(?i)\\b(?:FLAC|ALAC|APE|WV|WavPack|WAV|AIFF|DSD(?:64|128|256|512)?|DSF|DFF|SACD(?:-R)?|MP3|AAC|M4A|OPUS|OGG|Vorbis|WMA|AC3|DTS|MQA)\\b"
        ]
      },
      "filters": {
        "title_regex": {
          "mode": "any",
          "include": [
            "(?i)\\.(?:mkv|mp4|m4v|avi|mov|wmv|flv|webm|mpg|mpeg|m2ts|ts|vob)(?:$|[\\s)\\]])",
            "(?i)\\b(?:DVDRip|DVD-Rip|BDRip|BRRip|BluRay|Blu-Ray|WEBRip|WEB-DL|WEB-DLRip|HDTV|HDRip|REMUX|AVC|HEVC|H\\.264|H\\.265|x264|x265|XviD)\\b",
            "(?i)\\b(?:FLAC|ALAC|APE|WV|WavPack|WAV|AIFF|DSD(?:64|128|256|512)?|DSF|DFF|SACD(?:-R)?|MP3|AAC|M4A|OPUS|OGG|Vorbis|WMA|AC3|DTS|MQA)\\b"
          ],
          "exclude": []
        }
      },
      "inventory_category_mode": "first"
    },
    {
      "id": "rutor",
      "type": "rutor",
      "enabled": false,
      "priority": 20,
      "path": "../sources/rutor.ls",
      "size_unit": "binary",
      "remote_enabled": false,
      "url": "",
      "timeout": 30
    },
    {
      "id": "rutracker",
      "type": "rutracker",
      "enabled": false,
      "priority": 30,
      "path": "../sources/rutracker-20261031.xml.xz",
      "max_compressed_bytes": 8589934592,
      "max_expanded_bytes": 68719476736,
      "xz_memory_limit": 134217728,
      "max_topics": 10000000,
      "forum_include_ids": [],
      "extra_fields": {
        "description": false,
        "history": false,
        "duplicate_hints": false
      }
    },
    {
      "id": "jackett-indexer-example",
      "type": "jackett-torznab",
      "enabled": false,
      "priority": 40,
      "url": "http://127.0.0.1:9117/api/v2.0/indexers/example/results/torznab/api",
      "api_key": "",
      "timeout": 30,
      "page_size": 100,
      "max_pages": 5,
      "max_items": 5000,
      "overlap_seconds": 259200,
      "fetch_caps": true,
      "params": {}
    },
    {
      "id": "direct-rss-example",
      "type": "rss",
      "enabled": false,
      "priority": 40,
      "url": "https://example.invalid/releases.rss",
      "fetch_caps": false,
      "timeout": 30,
      "max_items": 1000,
      "overlap_seconds": 259200
    },
    {
      "id": "generic-json-template",
      "type": "template",
      "template": "generic-json",
      "enabled": false,
      "priority": 50,
      "path": "../sources/generic-feed.json"
    }
  ],
  "templates": {
    "generic-json": {
      "format": "json",
      "record_path": "$.items[*]",
      "fields": {
        "ih": "$.infohash",
        "magnet": "$.magnet",
        "title": "$.title",
        "date": "$.published",
        "size": "$.size",
        "files": "$.files",
        "categories": {
          "path": "$.categories[*]",
          "multiple": true
        }
      }
    },
    "generic-html": {
      "format": "html",
      "item_selector": "article.release",
      "fields": {
        "title": {
          "selector": "h2"
        },
        "magnet": {
          "selector": "a.magnet",
          "attr": "href"
        },
        "date": {
          "selector": "time",
          "attr": "datetime"
        },
        "size": {
          "selector": "span.size",
          "attr": "data-bytes"
        }
      }
    },
    "generic-text": {
      "format": "text",
      "pattern": "^(?P<ih>[0-9a-f]{40,64})\\|(?P<title>[^|]{1,256})\\|(?P<date>[0-9]{1,12})$",
      "fields": {
        "ih": {
          "group": "ih"
        },
        "title": {
          "group": "title"
        },
        "date": {
          "group": "date"
        }
      }
    }
  }
}
