#!/usr/bin/env python3
"""P2Play operator CLI."""

import sys

from p2play_publisher import PublisherError, build_parser, publish_import


def main():
    parser = build_parser()
    args = parser.parse_args()
    if args.timeout < 1 or args.timeout > 300:
        parser.error("--timeout must be between 1 and 300 seconds")
    try:
        if args.command == "publish":
            return publish_import(args)
    except PublisherError as exc:
        print(f"p2play: error: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("p2play: interrupted; no automatic retry was attempted", file=sys.stderr)
        return 130
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
