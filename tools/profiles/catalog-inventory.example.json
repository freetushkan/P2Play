  "templates": {
    "generic-json": {
      "format": "json",
      "record_path": "$.items[*]",
      "fields": {
        "ih": "$.infohash",
        "magnet": "$.magnet",
        "title": "$.title",
        "date": "$.published",
        "size": "$.size",
        "files": "$.files",
        "categories": {
          "path": "$.categories[*]",
          "multiple": true
        }
      }
    },
    "generic-html": {
      "format": "html",
      "item_selector": "article.release",
      "fields": {
        "title": {
          "selector": "h2"
        },
        "magnet": {
          "selector": "a.magnet",
          "attr": "href"
        },
        "date": {
          "selector": "time",
          "attr": "datetime"
        },
        "size": {
          "selector": "span.size",
          "attr": "data-bytes"
        }
      }
    },
    "generic-text": {
      "format": "text",
      "pattern": "^(?P<ih>[0-9a-f]{40,64})\\|(?P<title>[^|]{1,256})\\|(?P<date>[0-9]{1,12})$",
      "fields": {
        "ih": {
          "group": "ih"
        },
        "title": {
          "group": "title"
        },
        "date": {
          "group": "date"
        }
      }
    }
  },
  "_purpose": "Inventory only. Copy to a private profile, set paths relative to that copy (or absolute), then enable local sources. See docs/catalog-layout.md."
