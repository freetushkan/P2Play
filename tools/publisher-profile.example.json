{
  "version": 1,
  "publisher": {
    "field_whitelist": [
      "ih",
      "title",
      "shard",
      "date",
      "size",
      "files",
      "tags",
      "trackers",
      "description_ref",
      "poster_ref",
      "del"
    ],
    "category_map": {},
    "shard_policy": {
      "default": "default",
      "category_map": {}
    }
  },
  "sources": [
    {
      "id": "torrents-csv-data",
      "enabled": true,
      "priority": 10,
      "filters": {
        "title_regex": {
          "mode": "any",
          "include": [
            "(?i)\\.(?:mkv|mp4|m4v|avi|mov|wmv|flv|webm|mpg|mpeg|m2ts|ts|vob|iso)(?:$|[\\s)\\]])",
            "(?i)\\b(?:DVDRip|DVD-Rip|BDRip|BRRip|BluRay|Blu-Ray|WEBRip|WEB-DL|WEB-DLRip|HDTV|HDRip|REMUX|AVC|HEVC|H\\.264|H\\.265|x264|x265|XviD)\\b"
          ],
          "exclude": []
        }
      }
    },
    {
      "id": "rutor",
      "enabled": true,
      "priority": 20
    },
    {
      "id": "rutracker",
      "enabled": false,
      "priority": 30
    },
    {
      "id": "jackett-torznab",
      "enabled": true,
      "priority": 40
    }
  ]
}
